# Non-secret deployment configuration. Empty required values deliberately fail closed.
COMPOSE_PROJECT_NAME=pressure-intranet
PRESSURE_PLATFORM_ROOT=/srv/pressure-platform
PRESSURE_ALLOWED_HOSTS=
PRESSURE_PUBLIC_ORIGIN=
PRESSURE_BIND_IP=
PRESSURE_HTTP_PORT=8080
PRESSURE_BACKEND_IMAGE=
PRESSURE_WEB_IMAGE=
K6_DOCKER_IMAGE=
K6_EXPECTED_SHA256=
K6_DOCKER_NETWORK=pressure-intranet
K6_DOCKER_CPUS=
K6_DOCKER_MEMORY=
# Build-time references: choose and record verified linux/amd64 image digests.
PYTHON_IMAGE=
DOCKER_CLI_IMAGE=
NODE_IMAGE=
NGINX_IMAGE=
